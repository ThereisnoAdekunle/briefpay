# Arc network. Mainnet chain id 5042. Testnet chain id 5042002.
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.mainnet.arc.io
NEXT_PUBLIC_ARC_CHAIN_ID=5042
NEXT_PUBLIC_ARC_EXPLORER=https://explorer.arc.io
# Circle-issued USDC on Arc. 6 decimals. Same address on testnet.
NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
# Fill after you deploy contracts/MilestoneEscrow.sol
NEXT_PUBLIC_ESCROW_ADDRESS=
# Deployer / arbiter. Never commit a real key.
DEPLOYER_PRIVATE_KEY=
ARBITER_ADDRESS=
# Supabase. Project URL and the anon key are public in the browser.
# Service role key stays on the server only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Circle Programmable Wallets. Leave blank to use the connected browser wallet only.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
